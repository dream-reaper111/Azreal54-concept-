def lifecycle_action(action):
    if os.getuid() == 0:
        raise DeploymentError('Run this command as the ordinary rootless project user')
    manager = shutil.which('systemctl')
    if manager and UNIT_FILE.is_file():
        command = ['systemctl', '--user', action, 'azrael54.service']
        run(command, timeout=300)
        if action == 'start':
            service_manager_start()
    else:
        if action == 'start':
            service_manager_start()
        else:
            state = json.loads(STATE.read_text()) if STATE.is_file() else {}
            gpu = state.get('profile') == 'gpu'
            env = compose_environment(gpu=gpu)
            if gpu:
                env['AZRAEL_GPU_COMPOSE_FILE'] = str(GPU_COMPOSE_FILE)
            run(compose_prefix(gpu) + ['stop' if action == 'stop' else 'restart'], env=env)
    if action != 'stop':
        import setup_lab
        setup_lab.wait_for_services_healthy('podman', SERVICES, timeout=300)
    note(f'AZRAEL-54 lifecycle action completed: {action}')


def verify_deployment():
    import setup_lab
    state = json.loads(STATE.read_text()) if STATE.is_file() else {}
    profile = state.get('profile', 'cpu')
    gpu = profile == 'gpu'
    services = current_containers(provider_env())
    if set(services) < set(SERVICES):
        raise DeploymentError('One or more required AZRAEL services are absent')
    setup_lab.wait_for_services_healthy('podman', SERVICES, timeout=60)
    surface = verify_http_surface(int(os.environ.get('AZRAEL_PORT', '8765')))
    dashboard = setup_lab.verify_dashboard(int(os.environ.get('AZRAEL_PORT', '8765')))
    internal = setup_lab.verify_internal_services('podman')
    if gpu:
        cuda = setup_lab.verify_gpu_container('podman')
        inference = verify_api_inference(int(os.environ.get('AZRAEL_PORT', '8765')),
                                         os.environ.get('AZRAEL_GPU_UUID') or json.loads(STATE.read_text())['gpu']['authenticated_gpu_api_inference']['selected_device'],
                                         require_cuda=True)
        training_probe = state.get('gpu', {}).get('multi_gpu')
        if not training_probe or training_probe.get('status') != 'passed':
            raise DeploymentError('Real multi-GPU optimizer-step verification is not recorded')
    else:
        cuda = {'status': 'unavailable_or_not_selected'}
        inference = setup_lab.verify_slm('podman', require_gpu=False, gpu=False)
        training_probe = None
    sqlite_path = Path(os.environ.get('AZRAEL_STORAGE_ROOT', '/data/work/azrael54')) / 'juice-shop-data/juiceshop.sqlite'
    sqlite_result = None
    if sqlite_path.is_file():
        with sqlite3.connect(f'file:{sqlite_path}?mode=ro', uri=True) as connection:
            sqlite_result = connection.execute('PRAGMA quick_check').fetchone()[0]
    elif state.get('juice_shop_migration'):
        raise DeploymentError('Persisted Juice Shop SQLite database is missing')
    result = {'profile': profile, 'surface': surface, 'dashboard': dashboard,
              'internal_services': internal, 'cuda': cuda, 'inference': inference,
              'training_step': {'multi_gpu':training_probe,'individual_devices':state.get('gpu',{}).get('per_gpu',[]) if gpu else []},
              'juice_shop_sqlite_integrity': sqlite_result}
    note(json.dumps(result, indent=2, sort_keys=True))
    return result


def main(argv=None):
    forwarded=list(sys.argv[1:] if argv is None else argv)
    if forwarded and forwarded[0]=='training':
        return subprocess.call([str(ROOT/'aztrealcli'),*forwarded],cwd=ROOT)
    parser = argparse.ArgumentParser(prog='azraelctl', description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    bootstrap_parser = sub.add_parser('bootstrap', help='Install, build, deploy and verify AZRAEL-54')
    bootstrap_parser.add_argument('--gpu', choices=('auto', 'on', 'off'), default='auto',
                                  help='auto tries rootless CUDA and falls back to CPU (default: auto)')
    bootstrap_parser.add_argument('--port', type=int, default=8765, help='localhost dashboard port')
    for name, help_text in (
        ('start', 'Start existing AZRAEL services without rebuilding'),
        ('stop', 'Gracefully stop AZRAEL services without deleting state'),
        ('restart', 'Restart AZRAEL services and preserve persistent data'),
        ('status', 'Show containers, health endpoint, GPU and deployment state'),
        ('logs', 'Show recent AZRAEL service logs'),
        ('doctor', 'Run read-only host, Podman and NVIDIA diagnostics'),
        ('verify', 'Run live service, auth, inference, GPU and persistence verification'),
        ('update', 'Safely rebuild local project components with backup safeguards')):
        sub.add_parser(name, help=help_text, description=help_text)
    sub.add_parser('_service-start', help=argparse.SUPPRESS)
    sub.add_parser('_service-stop', help=argparse.SUPPRESS)
    sub.add_parser('training', help='Manage training candidates through aztrealcli training')
    args = parser.parse_args(argv)
    if args.command == 'bootstrap' and not 1024 <= args.port <= 65535:
        parser.error('--port must be from 1024 through 65535')
    try:
        if args.command == '_service-start':
            os.environ.update(read_compose_env())
            service_manager_start()
            return 0
        if args.command == '_service-stop':
            os.environ.update(read_compose_env())
            service_manager_stop()
            return 0
        with deployment_lock():
            if args.command == 'bootstrap':
                return bootstrap(args.gpu, args.port, force_update=False)
            if args.command == 'doctor':
                doctor()
                return 0
            if args.command == 'status':
                operational_status()
                return 0
            if args.command == 'logs':
                state = json.loads(STATE.read_text()) if STATE.is_file() else {}
                env = compose_environment(gpu=state.get('profile') == 'gpu')
                if state.get('profile') == 'gpu':
                    env['AZRAEL_GPU_COMPOSE_FILE'] = str(GPU_COMPOSE_FILE)
                run(compose_prefix(state.get('profile') == 'gpu') + ['logs', '--tail', '100'], env=env)
                return 0
            if args.command in {'start', 'stop', 'restart'}:
                lifecycle_action(args.command)
                return 0
            if args.command == 'verify':
                verify_deployment()
                return 0
            if args.command == 'update':
                return bootstrap('auto', 8765, force_update=True)
    except DeploymentError as error:
        note(f'ERROR {error}')
        return EXIT_DEPENDENCY if 'depend' in str(error).lower() or 'supported hosts' in str(error).lower() else EXIT_DEPLOYMENT
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        note(f'ERROR {type(error).__name__}: {error}')
        return EXIT_DEPLOYMENT
    return 0


if __name__ == '__main__':
    sys.exit(main())

