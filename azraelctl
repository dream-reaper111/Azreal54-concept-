def compatible_cdi_text(source, host_library_root=Path('/usr/lib/x86_64-linux-gnu')):
    """Build a Podman 4.9/read-only compatible, CUDA-only view of NVIDIA CDI."""
    import yaml

    spec = yaml.safe_load(source)
    if (not isinstance(spec, dict) or spec.get('cdiVersion') != '0.5.0' or
            spec.get('kind') != 'nvidia.com/gpu' or 'additionalGids' in source):
        raise DeploymentError('NVIDIA Toolkit did not generate the expected Podman-compatible CDI 0.5 spec')
    devices = spec.get('devices')
    if not isinstance(devices, list) or not devices:
        raise DeploymentError('Generated NVIDIA CDI spec has no devices')
    uuids = [str(item.get('name', '')) for item in devices if isinstance(item, dict)
             and re.fullmatch(r'GPU-[A-Fa-f0-9-]{36}', str(item.get('name', '')))]
    if not uuids:
        raise DeploymentError('Generated NVIDIA CDI spec contains no UUID names for stable GPU selection')

    library_root = Path('/usr/lib/x86_64-linux-gnu')
    host_library_root = Path(host_library_root).resolve()
    generated_mounts = []
    destinations = set()

    def add_library_alias(source_path, destination):
        """Replace a create-symlinks action with one read-only in-root bind mount."""
        target = Path(destination)
        if (not target.is_absolute() or target != Path(os.path.normpath(str(target))) or
                not target.is_relative_to(library_root)):
            # Display, Xorg, and other non-CUDA aliases are intentionally omitted.
            return
        if not target.name.startswith(('libcuda', 'libcudadebugger', 'libnvcuvid', 'libnvidia-', 'libnvoptix')):
            return
        src = Path(source_path)
        if src.is_absolute():
            raise DeploymentError('NVIDIA CDI library alias source must be relative to its target directory')
        relative_target = target.relative_to(library_root)
        try:
            resolved = (host_library_root / relative_target.parent / src).resolve(strict=True)
        except OSError as error:
            raise DeploymentError('NVIDIA CDI library alias target is missing or inaccessible') from error
        if not resolved.is_relative_to(host_library_root) or not resolved.is_file():
            raise DeploymentError('NVIDIA CDI library alias resolves outside the host driver library directory')
        if str(target) in destinations:
            prior = next(item for item in generated_mounts if item['containerPath'] == str(target))
            if prior['hostPath'] != str(resolved):
                raise DeploymentError('NVIDIA CDI library aliases collide at one container path')
            return
        destinations.add(str(target))
        generated_mounts.append({'hostPath': str(resolved), 'containerPath': str(target),
                                 'options': ['ro', 'nosuid', 'nodev', 'rbind', 'rprivate']})

    def strip_hooks(edits, *, per_device=False):
        if not isinstance(edits, dict):
            return
        nodes = edits.get('deviceNodes', [])
        if isinstance(nodes, list):
            # The lab uses CUDA compute only; DRM/display nodes are not required.
            edits['deviceNodes'] = [node for node in nodes if not (
                isinstance(node, dict) and str(node.get('path', '')).startswith('/dev/dri/')
            )]
        hooks = edits.get('hooks', [])
        retained = []
        for hook in hooks if isinstance(hooks, list) else []:
            if not isinstance(hook, dict):
                raise DeploymentError('NVIDIA CDI contains a malformed hook')
            args = hook.get('args', [])
            command = args[1] if len(args) > 1 else ''
            if command == 'create-symlinks':
                if not per_device:
                    index = 2
                    while index < len(args):
                        if args[index] == '--link' and index + 1 < len(args):
                            pair = str(args[index + 1])
                            if pair.count('::') != 1:
                                raise DeploymentError('NVIDIA CDI contains a malformed library symlink action')
                            source_path, destination = pair.split('::', 1)
                            add_library_alias(source_path, destination)
                            index += 2
                        else:
                            index += 1
                continue
            if command in ('update-ldcache', 'update-application-profile'):
                # These mutate image state or host-facing profile state and are
                # unnecessary when library aliases are mounted directly.
                continue
            retained.append(hook)
        if hooks:
            edits['hooks'] = retained

    for device in devices:
        if not isinstance(device, dict) or not isinstance(device.get('containerEdits', {}), dict):
            raise DeploymentError('NVIDIA CDI contains a malformed device entry')
        strip_hooks(device.get('containerEdits', {}), per_device=True)
    edits = spec.get('containerEdits', {})
    if not isinstance(edits, dict):
        raise DeploymentError('NVIDIA CDI global edits are malformed')
    strip_hooks(edits)

    # Only retain host library files needed by CUDA/NVML. Drop host sockets,
    # utility binaries, display configs, firmware, and graphics-only mounts.
    mounts = edits.get('mounts', [])
    retained_mounts = []
    for mount in mounts if isinstance(mounts, list) else []:
        if not isinstance(mount, dict):
            raise DeploymentError('NVIDIA CDI contains a malformed mount')
        host_path = Path(str(mount.get('hostPath', '')))
        container_path = Path(str(mount.get('containerPath', '')))
        if (host_path == Path('/usr/bin/nvidia-smi') and
                container_path == Path('/usr/bin/nvidia-smi')):
            try:
                resolved = host_path.resolve(strict=True)
            except OSError as error:
                raise DeploymentError('NVIDIA CDI nvidia-smi source is missing or inaccessible') from error
            if not resolved.is_file():
                raise DeploymentError('NVIDIA CDI nvidia-smi source is not a regular file')
            retained_mounts.append({'hostPath': str(resolved),
                                    'containerPath': '/usr/bin/nvidia-smi',
                                    'options': ['ro', 'nosuid', 'nodev', 'rbind', 'rprivate']})
            continue
        if (host_path.is_absolute() and container_path.is_absolute() and
                container_path.is_relative_to(library_root) and
                container_path.name.startswith(('libcuda', 'libcudadebugger', 'libnvcuvid', 'libnvidia-', 'libnvoptix'))):
            try:
                resolved = host_path.resolve(strict=True)
            except OSError as error:
                raise DeploymentError('NVIDIA CDI driver mount source is missing or inaccessible') from error
            if not resolved.is_relative_to(host_library_root) or not resolved.is_file():
                raise DeploymentError('NVIDIA CDI driver mount resolves outside the host library directory')
            mount['hostPath'] = str(resolved)
            mount['options'] = ['ro', 'nosuid', 'nodev', 'rbind', 'rprivate']
            retained_mounts.append(mount)
    edits['mounts'] = retained_mounts + generated_mounts
    env = edits.get('env', [])
    if not isinstance(env, list):
        raise DeploymentError('NVIDIA CDI environment edits are malformed')
    edits['env'] = [item for item in env if not str(item).startswith('LD_LIBRARY_PATH=')]
    edits['env'].append('LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu')
    return yaml.safe_dump(spec, sort_keys=False, explicit_start=True)


def ensure_cdi_compat_spec():
    """Create a private, user-owned CDI spec compatible with this host Podman."""
    global CDI_COMPAT_ACTIVE
    executable = shutil.which('nvidia-ctk')
    if not executable:
        raise DeploymentError('nvidia-ctk is unavailable; cannot prepare rootless NVIDIA CDI compatibility')
    log_path()
    CDI_COMPAT_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    if CDI_COMPAT_DIR.is_symlink() or CDI_COMPAT_DIR.stat().st_uid != os.getuid():
        raise DeploymentError('Private CDI compatibility directory must be owned by the project user')
    CDI_COMPAT_DIR.chmod(0o700)
    # Podman reads every YAML file in a CDI directory. Remove only staging files
    # written by earlier versions of this helper; never hide unrelated specs.
    for stale in CDI_COMPAT_DIR.glob('nvidia.*.tmp.yaml'):
        metadata = stale.lstat()
        if stale.is_symlink() or not stale.is_file() or metadata.st_uid != os.getuid():
            raise DeploymentError(f'Refusing to remove unexpected CDI staging file: {stale.name}')
        stale.unlink()
    unexpected_specs = [item.name for item in CDI_COMPAT_DIR.glob('*.yaml')
                        if item.name != 'nvidia.yaml']
    if unexpected_specs:
        raise DeploymentError('Private CDI directory contains unexpected specs: ' + ', '.join(unexpected_specs))
    fd, temporary_name = tempfile.mkstemp(prefix='nvidia.', suffix='.yaml', dir=RUNTIME)
    os.close(fd)
    temporary = Path(temporary_name)
    try:
        result = subprocess.run(
            [executable, 'cdi', 'generate', '--feature-flag',
             'no-additional-gids-for-device-nodes', '--output', str(temporary)],
            cwd=ROOT, capture_output=True, text=True, timeout=90,
        )
        if result.returncode:
            raise DeploymentError('NVIDIA CDI compatibility generation failed: ' +
                                  (result.stderr or result.stdout).strip()[-1200:])
        source = temporary.read_text()
        converted = compatible_cdi_text(source)
        import yaml
        spec = yaml.safe_load(converted)
        if not isinstance(spec, dict) or spec.get('kind') != 'nvidia.com/gpu' or not spec.get('devices'):
            raise DeploymentError('Generated NVIDIA CDI compatibility spec did not validate')
        names = {str(item.get('name', '')) for item in spec['devices'] if isinstance(item, dict)}
        try:
            import setup_lab
            expected = {item['uuid'].lower().replace('gpu-', 'gpu-') for item in setup_lab.host_gpu_inventory()}
        except (ImportError, KeyError, OSError, RuntimeError, ValueError):
            expected = set()
        if expected and not {item.casefold() for item in expected}.issubset(
                {item.casefold() for item in names}):
            raise DeploymentError('Generated CDI aliases do not cover every detected host GPU UUID')
        destination = CDI_COMPAT_DIR / 'nvidia.yaml'
        if destination.is_symlink():
            raise DeploymentError('Refusing to replace a symlink at the private CDI compatibility spec')
        staged = CDI_COMPAT_DIR / 'nvidia.yaml.new'
        out_fd = os.open(staged, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        with os.fdopen(out_fd, 'w') as stream:
            stream.write(converted)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(staged, destination)
        destination.chmod(0o600)
        CDI_COMPAT_ACTIVE = True
        os.environ['AZRAEL_CDI_COMPAT_SPEC_DIR'] = str(CDI_COMPAT_DIR)
        note('Prepared private rootless CDI compatibility spec (NVIDIA spec 0.5.0; no system files changed)')
        return {'status': 'passed', 'directory': str(CDI_COMPAT_DIR), 'spec_version': spec['cdiVersion'],
                'feature_flag': 'no-additional-gids-for-device-nodes', 'stable_uuid_aliases': sorted(expected or names)}
    finally:
        temporary.unlink(missing_ok=True)


def podman_compat_argv(argv):
    if not CDI_COMPAT_ACTIVE or Path(argv[0]).name != 'podman':
        return argv
    if not CDI_COMPAT_WRAPPER.is_file() or CDI_COMPAT_WRAPPER.is_symlink():
        raise DeploymentError('Rootless CDI compatibility wrapper is missing or unsafe')
    executable = shutil.which('podman') or argv[0]
    return [executable, 'unshare', str(CDI_COMPAT_WRAPPER), str(CDI_COMPAT_DIR), *argv]


def patch_podman_compose_source(source):
    """Make podman-compose 1.x honor service-scoped --no-deps recreation."""
    old_excluded = '''def get_excluded(compose, args):
    excluded = set()
    if args.services:
        excluded = set(compose.services)
        for service in args.services:
            excluded -= compose.services[service]["_deps"]
            excluded.discard(service)
    log("** excluding: ", excluded)
    return excluded
'''
    new_excluded = '''def get_excluded(compose, args):
    excluded = set()
    if args.services:
        excluded = set(compose.services)
        if getattr(args, "no_deps", False):
            for service in args.services:
                excluded.discard(service)
        else:
            for service in args.services:
                excluded -= compose.services[service]["_deps"]
                excluded.discard(service)
    log("** excluding: ", excluded)
    return excluded
'''
    old_recreate = '''    if args.force_recreate or len(diff_hashes):
        log("recreating: ...")
        down_args = argparse.Namespace(**dict(args.__dict__, volumes=False))
        compose.commands["down"](compose, down_args)
        log("recreating: done\\n\\n")
'''
    new_recreate = '''    partial_no_deps = bool(args.services) and getattr(args, "no_deps", False)
    if partial_no_deps:
        if args.force_recreate:
            selected = set(args.services)
            log("recreating selected services only: ", selected)
            for cnt in compose.containers:
                if cnt["_service"] in selected:
                    compose.podman.run([], "rm", ["--force", cnt["name"]])
    elif args.force_recreate or len(diff_hashes):
        log("recreating: ...")
        down_args = argparse.Namespace(**dict(args.__dict__, volumes=False))
        compose.commands["down"](compose, down_args)
        log("recreating: done\\n\\n")
'''
    if source.count(old_excluded) != 1 or source.count(old_recreate) != 1:
        raise DeploymentError('Installed podman-compose source does not match the audited service-scoped compatibility patch')
    return source.replace(old_excluded, new_excluded).replace(old_recreate, new_recreate)


_COMPOSE_PROVIDER_READY = None


def provider_executable():
    """Install a private audited provider shim without changing host packages."""
    global _COMPOSE_PROVIDER_READY
    if _COMPOSE_PROVIDER_READY:
        return _COMPOSE_PROVIDER_READY
    try:
        import inspect
        import podman_compose
    except ImportError as error:
        raise DeploymentError('podman-compose Python module is unavailable to the AZRAEL control interpreter') from error
    source_path = Path(inspect.getfile(podman_compose)).resolve(strict=True)
    source = patch_podman_compose_source(source_path.read_text())
    COMPOSE_PROVIDER_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    if COMPOSE_PROVIDER_DIR.is_symlink() or COMPOSE_PROVIDER_DIR.stat().st_uid != os.getuid():
        raise DeploymentError('Private podman-compose provider directory must be owned by the project user')
    COMPOSE_PROVIDER_DIR.chmod(0o700)
    module_path = COMPOSE_PROVIDER_DIR / 'podman_compose.py'
    if not module_path.is_file() or module_path.is_symlink() or module_path.read_text() != source:
        temporary = module_path.with_suffix('.tmp')
        temporary.write_text(source)
        temporary.chmod(0o600)
        os.replace(temporary, module_path)
    bin_dir = COMPOSE_PROVIDER_BIN.parent
    bin_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    if bin_dir.is_symlink() or bin_dir.stat().st_uid != os.getuid():
        raise DeploymentError('Private provider launcher directory must be owned by the project user')
    bin_dir.chmod(0o700)
    launcher = ('#!/bin/sh\n'
                f'export PYTHONPATH={shlex.quote(str(COMPOSE_PROVIDER_DIR))}${{PYTHONPATH:+:$PYTHONPATH}}\n'
                f'exec {shlex.quote(sys.executable)} -c \'import podman_compose; podman_compose.main()\' "$@"\n')
    if not COMPOSE_PROVIDER_BIN.is_file() or COMPOSE_PROVIDER_BIN.is_symlink() or COMPOSE_PROVIDER_BIN.read_text() != launcher:
        temporary = COMPOSE_PROVIDER_BIN.with_suffix('.tmp')
        temporary.write_text(launcher)
        temporary.chmod(0o700)
        os.replace(temporary, COMPOSE_PROVIDER_BIN)
    COMPOSE_PROVIDER_BIN.chmod(0o700)
    check = subprocess.run([str(COMPOSE_PROVIDER_BIN), '--version'], capture_output=True,
                           text=True, timeout=30, cwd=ROOT)
    if check.returncode or 'podman-compose version' not in check.stdout:
        raise DeploymentError('Private service-scoped podman-compose provider failed its version probe: ' +
                              (check.stderr or check.stdout).strip()[-600:])
    _COMPOSE_PROVIDER_READY = str(COMPOSE_PROVIDER_BIN)
    return _COMPOSE_PROVIDER_READY


def log_path():
    RUNTIME.mkdir(mode=0o700, parents=True, exist_ok=True)
    if RUNTIME.is_symlink() or RUNTIME.stat().st_uid != os.getuid():
        raise DeploymentError('Runtime state directory must be a real directory owned by the current user')
    RUNTIME.chmod(0o700)
    return RUNTIME / 'azraelctl.log'


def note(message):
    timestamp = datetime.now(timezone.utc).isoformat()
    line = f'[{timestamp}] {message}'
    print(line, flush=True)
    path = log_path()
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'a') as stream:
        stream.write(line + '\n')
    path.chmod(0o600)


def verification_stage(name, operation):
    """Retry one transient socket timeout during cold dashboard startup."""
    note('VERIFY ' + name)
    try:
        result = operation()
    except TimeoutError:
        note(name + ' timed out during cold startup; retrying once after 2 seconds')
        time.sleep(2)
        result = operation()
    note('PASS ' + name)
    return result


@contextmanager
def deployment_lock():
    path = log_path().with_name('azraelctl.lock')
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise DeploymentError('Another azraelctl operation holds the deployment lock') from error
        yield
    finally:
        os.close(fd)


def run(argv, *, env=None, check=True, cwd=ROOT, timeout=3600, display=True):
    """Run and retain command output without writing credentials to logs."""
    if isinstance(argv, str) or not argv or any(not isinstance(item, str) for item in argv):
        raise TypeError('Commands must be nonempty argument arrays')
    log = log_path()
    safe_cmd = ' '.join(argv)
    execution_argv = podman_compat_argv(argv)
    note(f'RUN {safe_cmd}')
    chunks = []
    fd = os.open(log, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'a') as stream:
        process = subprocess.Popen(execution_argv, cwd=cwd, env=env, stdout=subprocess.PIPE,
                                   stderr=subprocess.STDOUT, text=True, bufsize=1)
        try:
            for line in process.stdout:
                chunks.append(line)
                stream.write(line)
                stream.flush()
                if display:
                    sys.stdout.write(line)
                    sys.stdout.flush()
            code = process.wait(timeout=timeout)
        except BaseException:
            process.kill()
            process.wait()
            raise
        finally:
            if process.stdout:
                process.stdout.close()
    output = ''.join(chunks)
    if code and check:
        raise DeploymentError(f'Command failed ({code}): {safe_cmd}\n{output[-1800:]}')
    return subprocess.CompletedProcess(argv, code, output, '')


def os_release():
    values = {}
    try:
        for line in Path('/etc/os-release').read_text().splitlines():
            if '=' in line:
                key, value = line.split('=', 1)
                values[key] = value.strip().strip('"')
    except OSError:
        pass
    return values


def supported_host():
    release = os_release()
    arch = platform.machine()
    if release.get('ID') not in {'pop', 'ubuntu'} and 'ubuntu' not in release.get('ID_LIKE', '').split():
        raise DeploymentError('Supported hosts are Pop!_OS or Ubuntu; detected ' + release.get('PRETTY_NAME', 'unknown OS'))
    if arch not in {'x86_64', 'amd64'}:
        raise DeploymentError('Supported container image architecture is x86_64; detected ' + arch)
    return {'distribution': release.get('PRETTY_NAME', release.get('ID', 'unknown')),
            'version': release.get('VERSION_ID'), 'architecture': arch}


def dependency_report():
    required = ('python3', 'git', 'podman', 'podman-compose', 'curl')
    found = {name: shutil.which(name) for name in required}
    optional = {name: shutil.which(name) for name in ('nvidia-smi', 'nvidia-ctk', 'loginctl', 'systemctl')}
    return {'required': found, 'optional': optional,
            'missing_required': [name for name, path in found.items() if not path]}


def install_missing_dependencies(report):
    packages = {'python3': 'python3', 'git': 'git', 'podman': 'podman',
                'podman-compose': 'podman-compose', 'curl': 'curl'}
    missing = [packages[name] for name in report['missing_required']]
    if not missing:
        return
    if 'python3' in report['missing_required']:
        missing.extend(['python3-venv', 'python3-pip'])
    elif not (ROOT / '.slm-venv/bin/python').is_file():
        venv_probe = subprocess.run([shutil.which('python3') or 'python3', '-m', 'venv', '--help'],
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if venv_probe.returncode:
            missing.append('python3-venv')
    command = ['sudo', '-n', 'apt-get', 'install', '-y', *dict.fromkeys(missing)]
    if shutil.which('sudo') is None:
        raise DeploymentError('Missing supported host packages: ' + ', '.join(missing) + '. Install those packages and retry.')
    result = run(command, check=False)
    if result.returncode:
        raise DeploymentError('Could not install missing packages without an interactive privilege prompt. Run this targeted command, then retry: sudo apt-get install -y ' + ' '.join(dict.fromkeys(missing)))
    left = dependency_report()['missing_required']
    if left:
        raise DeploymentError('Dependencies remain unavailable after installation: ' + ', '.join(left))


def ensure_venv_dependencies():
    python = ROOT / '.slm-venv/bin/python'
    if not python.is_file():
        note('Creating project Python virtual environment')
        run([shutil.which('python3') or 'python3', '-m', 'venv', str(ROOT / '.slm-venv')])
    check = run([str(python), '-c',
                 'import torch, transformers, sklearn; print(torch.__version__, transformers.__version__, sklearn.__version__)'],
                check=False, display=False)
    if check.returncode:
        note('Installing missing pinned Python runtime dependencies into .slm-venv')
        run([str(python), '-m', 'pip', 'install', '--disable-pip-version-check',
             '-r', str(ROOT / 'requirements-runtime.txt')])
        run([str(python), '-c', 'import torch, transformers, sklearn'])
    else:
        note('Python venv dependencies already satisfy the runtime imports; no reinstall needed')


def provider_env():
    provider = provider_executable()
    return dict(os.environ, PODMAN_COMPOSE_PROVIDER=provider)


def recovery_backup_status():
    if not BACKUP_ROOT.is_dir() or BACKUP_ROOT.is_symlink():
        raise DeploymentError(f'Existing recovery backup not found at {BACKUP_ROOT}; refusing container recreation')
    manifest_path = BACKUP_ROOT / 'backup-manifest.json'
    manifest = json.loads(manifest_path.read_text())
    if manifest.get('verification', {}).get('sqlite_integrity') != 'ok' or not manifest.get('verification', {}).get('snapshot_archive_reloaded'):
        raise DeploymentError('Existing Juice Shop backup manifest lacks verified SQLite/image snapshot evidence')
    check = run(['sha256sum', '-c', str(BACKUP_ROOT / 'SHA256SUMS')], cwd=BACKUP_ROOT,
                display=False, timeout=300)
    archive_sha = BACKUP_ROOT / 'legacy-project-state.tar.gz.sha256'
    if not archive_sha.is_file() or not (BACKUP_ROOT / 'legacy-project-state.tar.gz').is_file():
        raise DeploymentError('Legacy dataset/model/evidence archive verification is incomplete; refusing deployment')
    run(['sha256sum', '-c', str(archive_sha)], cwd=BACKUP_ROOT, display=False)
    run(['tar', '-tzf', str(BACKUP_ROOT / 'legacy-project-state.tar.gz')],
        check=True, display=False, timeout=600)
    return {'manifest': manifest, 'checksums': 'passed', 'legacy_archive': archive_sha.is_file()}


def image_id(reference, env):
    result = run(['podman', 'image', 'inspect', '--format', '{{.Id}}', reference],
                 env=env, check=False, display=False)
    return result.stdout.strip() if result.returncode == 0 else None


def current_containers(env):
    listing = run(['podman', 'ps', '-aq', '--filter', f'label=com.docker.compose.project={PROJECT}'],
                  env=env, check=False, display=False)
    if listing.returncode:
        raise DeploymentError('Could not list AZRAEL containers')
    containers = {}
    for identifier in (item.strip() for item in listing.stdout.splitlines() if item.strip()):
        result = run(['podman', 'inspect', identifier], env=env, display=False)
        item = json.loads(result.stdout)[0]
        labels = item.get('Config', {}).get('Labels') or {}
        service = labels.get('com.docker.compose.service') or labels.get('io.podman.compose.service')
        if service in SERVICES:
            containers[service] = item
    return containers


def compose_signature():
    files = set(ROOT.glob('*.py')) | set(ROOT.glob('*.json')) | set(ROOT.glob('requirements*.txt'))
    for directory in ('container', 'web', 'models-more', 'models-specialists',
                      'models-public', 'models-domains', 'models-automotive'):
        files.update(path for path in (ROOT / directory).rglob('*') if path.is_file())
    files.update(ROOT / name for name in ('compose.yaml', 'compose.podman.yaml', 'compose.gpu.yaml'))
    digest = hashlib.sha256()
    for path in sorted(files):
        if path.is_symlink():
            raise DeploymentError(f'Compose source must not be a symlink: {path.relative_to(ROOT)}')
        digest.update(path.relative_to(ROOT).as_posix().encode() + b'\0')
        digest.update(path.read_bytes())
    return digest.hexdigest()


def compose_service_signatures(gpu=False):
    """Hash each effective service's own Compose stanza so changes stay scoped."""
    import yaml
    compose_files = [ROOT / 'compose.yaml', ROOT / 'compose.podman.yaml']
    if gpu:
        generated = Path(os.environ.get('AZRAEL_GPU_COMPOSE_FILE', str(GPU_COMPOSE_FILE)))
        compose_files.append(generated if generated.is_file() else ROOT / 'compose.gpu.yaml')
    documents = []
    for path in compose_files:
        if not path.is_file():
            continue
        parsed = yaml.safe_load(path.read_text()) or {}
        if not isinstance(parsed, dict):
            raise DeploymentError(f'Invalid Compose document: {path.name}')
        documents.append((path.name, parsed))
    signatures = {}
    for service in SERVICES:
        payload = []
        for filename, document in documents:
            services = document.get('services') or {}
            shared = {key: document[key] for key in ('networks', 'secrets', 'volumes') if key in document}
            payload.append((filename, shared, services.get(service)))
        serialized = json.dumps(payload, sort_keys=True, separators=(',', ':')).encode()
        signatures[service] = hashlib.sha256(serialized).hexdigest()
    return signatures


def health_is_healthy(item):
    state = item.get('State', {})
    return state.get('Status') == 'running' and (state.get('Health') or {}).get('Status') == 'healthy'


def web_lab_persistent_mounts_ready(item):
    """Return true only when every lab data path is already backed by its stable host bind."""
    if not item:
        return False
    storage = Path(os.environ.get('AZRAEL_STORAGE_ROOT', '/data/work/azrael54')).resolve()
    configured = {
        '/juice-shop/data': Path(os.environ.get('AZRAEL_JUICE_SHOP_DATA_ROOT', str(storage / 'juice-shop-data'))),
        '/juice-shop/logs': Path(os.environ.get('AZRAEL_JUICE_SHOP_LOG_ROOT', str(storage / 'juice-shop-logs'))),
        '/juice-shop/ftp': Path(os.environ.get('AZRAEL_JUICE_SHOP_FTP_ROOT', str(storage / 'juice-shop-ftp'))),
        '/juice-shop/.well-known/csaf': Path(os.environ.get('AZRAEL_JUICE_SHOP_CSAF_ROOT', str(storage / 'juice-shop-csaf'))),
        '/juice-shop/frontend/dist/frontend': Path(os.environ.get('AZRAEL_JUICE_SHOP_FRONTEND_ROOT', str(storage / 'juice-shop-frontend'))),
        '/juice-shop/i18n': Path(os.environ.get('AZRAEL_JUICE_SHOP_I18N_ROOT', str(storage / 'juice-shop-i18n'))),
        '/healthcheck.js': ROOT / 'healthcheck.js',
        '/bin/sh': Path(os.environ.get('AZRAEL_WEB_LAB_SHELL', '/usr/bin/busybox')),
    }
    mounts = {mount.get('Destination'): mount for mount in (item.get('Mounts') or [])
              if mount.get('Type') == 'bind' and mount.get('Destination')}
    for destination, expected_source in configured.items():
        mount = mounts.get(destination)
        source_path = Path(mount.get('Source', '')) if mount else None
        if not mount or not source_path or source_path.is_symlink() or not source_path.exists():
            return False
        if source_path.resolve(strict=True) != expected_source.resolve(strict=True):
            return False
        expected_rw = destination not in {'/healthcheck.js', '/bin/sh'}
        if bool(mount.get('RW')) != expected_rw:
            return False
        if expected_rw and not source_path.is_dir():
            return False
    return True


def needs_recreation(service, item, desired_image, signature, old_state, gpu,
                     service_signature=None):
    if not item:
        return True
    if not health_is_healthy(item):
        return True
    if (item.get('HostConfig', {}).get('RestartPolicy') or {}).get('Name') != 'unless-stopped':
        return True
    saved_service_signatures = old_state.get('service_signatures') or {}
    if service in saved_service_signatures and saved_service_signatures[service] != service_signature:
        return True
    if item.get('Image') != desired_image:
        # The Juice Shop recovery tag is intentionally refreshed during every backup.
        # Its digest is therefore not a stable deployment signal once data is bind-mounted.
        if service != 'web-lab' or not web_lab_persistent_mounts_ready(item):
            return True
    old_profile = old_state.get('profile', 'cpu')
    if service in {'dashboard', 'frontend'} and (old_profile == 'gpu') != gpu:
        return True
    return False


def container_snapshot(container_id, tag, archive, env):
    run(['podman', 'commit', '--format', 'oci', '--pause', container_id, tag], env=env, timeout=300)
    run(['podman', 'save', '--format', 'oci-archive', '--output', str(archive), tag], env=env, timeout=900)
    archive.chmod(0o600)
    hasher = hashlib.sha256()
    with archive.open('rb') as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b''):
            hasher.update(chunk)
    digest = hasher.hexdigest()
    run(['podman', 'load', '--input', str(archive)], env=env, timeout=900)
    loaded = image_id(tag, env)
    if not loaded:
        raise DeploymentError(f'Container snapshot {tag} could not be reloaded')
    return {'tag': tag, 'image_id': loaded, 'archive': str(archive),
            'archive_sha256': digest, 'archive_bytes': archive.stat().st_size,
            'reload_verification': 'passed'}


def copy_from_snapshot(image, backup_dir, env):
    helper = run(['podman', 'create', '--network', 'none', '--entrypoint', '/bin/sh', image],
                 env=env).stdout.strip().splitlines()[-1]
    try:
        data = backup_dir / 'important-files/juice-shop-data'
        logs = backup_dir / 'important-files/juice-shop-logs'
        ftp = backup_dir / 'important-files/juice-shop-ftp'
        csaf = backup_dir / 'important-files/juice-shop-csaf'
        data.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        run(['podman', 'cp', f'{helper}:/juice-shop/data', str(data)], env=env)
        run(['podman', 'cp', f'{helper}:/juice-shop/logs', str(logs)], env=env)
        run(['podman', 'cp', f'{helper}:/juice-shop/ftp', str(ftp)], env=env)
        run(['podman', 'cp', f'{helper}:/juice-shop/.well-known/csaf', str(csaf)], env=env)
        db = data / 'juiceshop.sqlite'
        if not db.is_file():
            raise DeploymentError('Snapshot does not contain /juice-shop/data/juiceshop.sqlite')
        with sqlite3.connect(f'file:{db}?mode=ro', uri=True) as connection:
            integrity = connection.execute('PRAGMA quick_check').fetchone()[0]
            tables = connection.execute("SELECT count(*) FROM sqlite_master WHERE type='table'").fetchone()[0]
        if integrity != 'ok' or tables < 1:
            raise DeploymentError(f'Snapshot SQLite verification failed: quick_check={integrity}, tables={tables}')
        for directory in (data, logs, ftp, csaf):
            for current, dirs, files in os.walk(directory):
                Path(current).chmod(0o700)
                for name in dirs:
                    (Path(current) / name).chmod(0o700)
                for name in files:
                    (Path(current) / name).chmod(0o600)
        return {'data': data, 'logs': logs, 'ftp': ftp, 'csaf': csaf, 'database': db,
                'sqlite_integrity': integrity, 'sqlite_tables': tables,
                'database_sha256': hashlib.sha256(db.read_bytes()).hexdigest(),
                'log_file_count': sum(1 for path in logs.rglob('*') if path.is_file()),
                'ftp_file_count': sum(1 for path in ftp.rglob('*') if path.is_file()),
                'csaf_file_count': sum(1 for path in csaf.rglob('*') if path.is_file())}
    finally:
        run(['podman', 'rm', helper], env=env, check=False, display=False)


def copy_from_container(container_id, backup_dir, env):
    """Copy the stopped container's effective paths, including any bind-mounted data."""
    data = backup_dir / 'important-files/juice-shop-data'
    logs = backup_dir / 'important-files/juice-shop-logs'
    ftp = backup_dir / 'important-files/juice-shop-ftp'
    csaf = backup_dir / 'important-files/juice-shop-csaf'
    frontend = backup_dir / 'important-files/juice-shop-frontend'
    i18n = backup_dir / 'important-files/juice-shop-i18n'
    data.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    for source, destination in (
        ('/juice-shop/data',data),('/juice-shop/logs',logs),('/juice-shop/ftp',ftp),
        ('/juice-shop/.well-known/csaf',csaf),('/juice-shop/frontend/dist/frontend',frontend),
        ('/juice-shop/i18n',i18n),
    ):
        if destination.exists() or destination.is_symlink():
            raise DeploymentError('Refusing to overwrite a preserved container copy: '+str(destination))
        stage=Path(tempfile.mkdtemp(prefix='.container-copy-',dir=data.parent))
        run(['podman','cp',f'{container_id}:{source}',str(stage)],env=env)
        nested=stage/Path(source).name
        copied=nested if nested.is_dir() else stage
        tree_hashes(copied)
        os.replace(copied,destination)
        if copied!=stage:stage.rmdir()
    db = data / 'juiceshop.sqlite'
    if not db.is_file():
        raise DeploymentError('Stopped Juice Shop container does not expose /juice-shop/data/juiceshop.sqlite')
    with sqlite3.connect(f'file:{db}?mode=ro', uri=True) as connection:
        integrity = connection.execute('PRAGMA quick_check').fetchone()[0]
        tables = connection.execute("SELECT count(*) FROM sqlite_master WHERE type='table'").fetchone()[0]
    if integrity != 'ok' or tables < 1:
        raise DeploymentError(f'Stopped-container SQLite verification failed: quick_check={integrity}, tables={tables}')
    for directory in (data, logs, ftp, csaf, frontend, i18n):
        for current, dirs, files in os.walk(directory):
            Path(current).chmod(0o700)
            for name in dirs:
                (Path(current) / name).chmod(0o700)
            for name in files:
                (Path(current) / name).chmod(0o600)
    return {'data': data, 'logs': logs, 'ftp': ftp, 'csaf': csaf, 'frontend':frontend, 'i18n':i18n, 'database': db,
            'sqlite_integrity': integrity, 'sqlite_tables': tables,
            'database_sha256': hashlib.sha256(db.read_bytes()).hexdigest(),
            'log_file_count': sum(1 for path in logs.rglob('*') if path.is_file()),
            'ftp_file_count': sum(1 for path in ftp.rglob('*') if path.is_file()),
            'csaf_file_count': sum(1 for path in csaf.rglob('*') if path.is_file())}


def merge_juice_shop_trees(seed, current, destination):
    """Create a new backup tree, retaining live files over matching image assets."""
    seed,current,destination=Path(seed),Path(current),Path(destination)
    if destination.exists() or destination.is_symlink():
        raise DeploymentError('Refusing to overwrite an existing merged tree')
    if not seed.is_dir() or not current.is_dir() or seed.is_symlink() or current.is_symlink():
        raise DeploymentError('Merge sources must be regular directories')
    tree_hashes(seed);tree_hashes(current)
    shutil.copytree(seed,destination)
    shutil.copytree(current,destination,dirs_exist_ok=True)
    return destination


def tree_hashes(root):
    root = Path(root)
    result = {}
    for path in sorted(root.rglob('*')):
        relative = path.relative_to(root).as_posix()
        if path.is_symlink():
            raise DeploymentError(f'Refusing a symlink in protected Juice Shop data: {path}')
        if path.is_dir():
            result[relative] = 'directory'
        elif path.is_file():
            digest = hashlib.sha256()
            with path.open('rb') as stream:
                for chunk in iter(lambda: stream.read(1024 * 1024), b''):
                    digest.update(chunk)
            result[relative] = digest.hexdigest()
        else:
            raise DeploymentError(f'Unsupported entry in protected Juice Shop data: {path}')
    return result


def make_private_tree(root):
    root = Path(root)
    root.chmod(0o700)
    for path in root.rglob('*'):
        path.chmod(0o700 if path.is_dir() else 0o600)


def backup_active_juice_shop(source, target, backup_dir):
    """Verify a backup of existing state before replacing it with the stopped-container copy."""
    source = Path(source)
    target = Path(target)
    if target.exists() and any(target.iterdir()):
        backup = backup_dir / 'important-files' / (target.name + '-existing')
        shutil.copytree(target, backup, dirs_exist_ok=False)
        make_private_tree(backup)
        prior_hashes = tree_hashes(target)
        if tree_hashes(backup) != prior_hashes:
            raise DeploymentError(f'Existing Juice Shop data backup did not verify: {backup}')
        existing_db = target / 'juiceshop.sqlite'
        if existing_db.is_file():
            with sqlite3.connect(f'file:{backup / "juiceshop.sqlite"}?mode=ro', uri=True) as connection:
                integrity = connection.execute('PRAGMA quick_check').fetchone()[0]
            if integrity != 'ok':
                raise DeploymentError(f'Existing Juice Shop SQLite backup failed verification: {integrity}')
        source_hashes = tree_hashes(source)
        if prior_hashes == source_hashes:
            return {'path': str(target), 'preserved_existing': True,
                    'backup_copy': str(backup), 'file_count': sum(1 for p in target.rglob('*') if p.is_file()),
                    'content_matches_final_snapshot': True, 'backup_verification': 'passed'}

        stage = target.with_name(target.name + '.azrael54-staging')
        previous = target.with_name(target.name + f'.azrael54-previous-{time.time_ns()}')
        if stage.exists() or previous.exists():
            raise DeploymentError(f'Juice Shop migration staging path already exists beside {target}')
        shutil.copytree(source, stage)
        make_private_tree(stage)
        if tree_hashes(stage) != source_hashes:
            shutil.rmtree(stage)
            raise DeploymentError(f'New Juice Shop data staging copy did not verify: {stage}')
        moved_old = False
        try:
            target.rename(previous)
            moved_old = True
            stage.rename(target)
            if tree_hashes(target) != source_hashes:
                raise DeploymentError(f'Installed Juice Shop data failed post-migration verification: {target}')
        except BaseException:
            if target.exists():
                shutil.rmtree(target)
            if moved_old and previous.exists():
                previous.rename(target)
            raise
        shutil.rmtree(previous)
        return {'path': str(target), 'preserved_existing': True, 'backup_copy': str(backup),
                'file_count': sum(1 for p in target.rglob('*') if p.is_file()),
                'content_matches_final_snapshot': True, 'prior_state_backup_verification': 'passed',
                'prior_state_sha256_manifest': prior_hashes}
    target.mkdir(mode=0o700, parents=True, exist_ok=True)
    if any(target.iterdir()):
        raise DeploymentError(f'Persistent Juice Shop destination became nonempty during migration: {target}')
    shutil.copytree(source, target, dirs_exist_ok=True)
    make_private_tree(target)
    if tree_hashes(target) != tree_hashes(source):
        raise DeploymentError(f'New Juice Shop persistent copy did not verify: {target}')
    return {'path': str(target), 'preserved_existing': False,
            'file_count': sum(1 for p in target.rglob('*') if p.is_file())}


def save_json(path, value):
    path = Path(path)
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    temporary = path.with_name(path.name + '.tmp')
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'w') as stream:
        json.dump(value, stream, indent=2, sort_keys=True)
        stream.write('\n')
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(temporary, path)
    path.chmod(0o600)


def snapshot_and_migrate_web_lab(item, backup_dir, env):
    container_id = item['Id']
    status = item.get('State', {}).get('Status')
    now = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')
    detail = backup_dir / 'web-lab-latest'
    detail.mkdir(mode=0o700)
    save_json(detail / 'container-inspect.json', item)
    diff = run(['podman', 'diff', container_id], env=env, display=False)
    (detail / 'container-diff.txt').write_text(diff.stdout)
    (detail / 'container-diff.txt').chmod(0o600)
    log_result = run(['podman', 'logs', '--timestamps', container_id], env=env, check=False, display=False)
    (detail / 'container-logs.txt').write_text(log_result.stdout[-4_000_000:])
    (detail / 'container-logs.txt').chmod(0o600)

    first = container_snapshot(container_id, f'localhost/azrael54-web-lab-preserved:pre-stop-{now}',
                               detail / 'web-lab-pre-stop.oci.tar', env)
    pre_stop = copy_from_snapshot(first['tag'], detail / 'pre-stop-files', env)
    if status == 'running':
        run(['podman', 'stop', '--time', '15', container_id], env=env, timeout=60)
    try:
        stopped_item = json.loads(run(['podman', 'inspect', container_id], env=env, display=False).stdout)[0]
        if stopped_item.get('State', {}).get('Status') != 'exited':
            raise DeploymentError('Juice Shop did not reach a stopped state for its final data snapshot')
        final = container_snapshot(container_id, f'localhost/azrael54-web-lab-preserved:deployment-{now}',
                                   detail / 'web-lab-final.oci.tar', env)
        final_files = copy_from_container(container_id, detail / 'final-files', env)
        if final_files['sqlite_integrity'] != 'ok':
            raise DeploymentError('Final stopped Juice Shop database failed integrity verification')
        active_root = Path(os.environ.get('AZRAEL_STORAGE_ROOT', '/data/work/azrael54'))
        data_path = active_root / 'juice-shop-data'
        logs_path = active_root / 'juice-shop-logs'
        ftp_path = active_root / 'juice-shop-ftp'
        csaf_path = active_root / 'juice-shop-csaf'
        data_preservation = backup_active_juice_shop(final_files['data'], data_path, detail)
        log_preservation = backup_active_juice_shop(final_files['logs'], logs_path, detail)
        ftp_preservation = backup_active_juice_shop(final_files['ftp'], ftp_path, detail)
        csaf_preservation = backup_active_juice_shop(final_files['csaf'], csaf_path, detail)
        active_db = data_path / 'juiceshop.sqlite'
        if not active_db.is_file():
            raise DeploymentError('Persistent Juice Shop data has no SQLite database after migration')
        with sqlite3.connect(f'file:{active_db}?mode=ro', uri=True) as connection:
            active_integrity = connection.execute('PRAGMA quick_check').fetchone()[0]
        if active_integrity != 'ok':
            raise DeploymentError('Persistent Juice Shop database failed post-migration integrity check')
        run(['podman', 'tag', final['tag'], 'localhost/azrael54-web-lab-preserved:latest'], env=env)
        manifest = {'source_container_id': container_id, 'source_status_before': status,
                    'writable_layer_diff': diff.stdout, 'pre_stop_snapshot': first,
                    'pre_stop_sqlite_sha256': pre_stop['database_sha256'], 'final_snapshot': final,
                    'final_sqlite_sha256': final_files['database_sha256'],
                    'sqlite_integrity': active_integrity, 'sqlite_tables': final_files['sqlite_tables'],
                    'active_data': data_preservation, 'active_logs': log_preservation,
                    'active_ftp': ftp_preservation, 'active_csaf': csaf_preservation,
                    'active_image': 'localhost/azrael54-web-lab-preserved:latest',
                    'migration_reversible_from': str(detail / 'web-lab-final.oci.tar'),
                    'status': 'verified'}
        save_json(detail / 'migration-manifest.json', manifest)
        return manifest
    except BaseException:
        current = json.loads(run(['podman', 'inspect', container_id], env=env, check=False, display=False).stdout or '[]')
        if current and current[0].get('State', {}).get('Status') != 'running':
            run(['podman', 'start', container_id], env=env, check=False, display=False)
        raise


def restore_web_lab_after_failure(item, env):
    """Recover the old container or the verified snapshot-backed service after a failed update."""
    original_id = item.get('Id')
    inspected = run(['podman', 'inspect', original_id], env=env, check=False, display=False)
    if inspected.returncode == 0:
        current = json.loads(inspected.stdout)[0]
        if current.get('State', {}).get('Status') != 'running':
            started = run(['podman', 'start', original_id], env=env, check=False, display=False)
            if started.returncode == 0:
                return {'status': 'restored_original_container', 'container_id': original_id}
    try:
        snapshot = 'localhost/azrael54-web-lab-preserved:latest'
        if image_id(snapshot, env):
            port = int(env.get('AZRAEL_PORT', os.environ.get('AZRAEL_PORT', '8765')))
            env = write_compose_env('cpu', web_image=snapshot, port=port)
            env.update({'AZRAEL_WEB_LAB_IMAGE': snapshot,
                        'AZRAEL_STORAGE_ROOT': str(Path('/data/work/azrael54')),
                        'PODMAN_COMPOSE_PROVIDER': provider_executable()})
        run_compose_up('web-lab', gpu=False, force=False, env=env)
        import setup_lab
        setup_lab.wait_for_services_healthy('podman', ['web-lab'], timeout=120)
        return {'status': 'restored_from_verified_snapshot_and_persistent_data',
                'image': env.get('AZRAEL_WEB_LAB_IMAGE')}
    except Exception as error:
        return {'status': 'recovery_required', 'snapshot_image': 'localhost/azrael54-web-lab-preserved:latest',
                'error': f'{type(error).__name__}: {str(error)[:800]}'}


def ensure_web_lab_shell():
    source=Path(os.environ.get('AZRAEL_WEB_LAB_SHELL') or shutil.which('busybox') or '/usr/bin/busybox').resolve()
    if not source.is_file() or not os.access(source,os.X_OK):
        raise DeploymentError('A working BusyBox executable is required for the read-only web-lab shell mount')
    directory=RUNTIME/'compat'
    directory.mkdir(mode=0o700,parents=True,exist_ok=True)
    target=directory/'busybox'
    if target.is_symlink() or (target.exists() and target.stat().st_uid!=os.getuid()):
        raise DeploymentError('Web-lab compatibility shell must be owned by the project user')
    if source!=target.resolve():
        if not target.exists():shutil.copyfile(source,target)
        elif hashlib.sha256(source.read_bytes()).digest()!=hashlib.sha256(target.read_bytes()).digest():
            raise DeploymentError('Existing compatibility shell differs; preserve it before an explicit replacement')
    target.chmod(0o555)
    return target


def write_compose_env(profile, gpu_devices=None, default_gpu=None, web_image=None, port=8765):
    storage = Path(os.environ.get('AZRAEL_STORAGE_ROOT', '/data/work/azrael54'))
    values = {'AZRAEL_HOME':str(ROOT), 'LAB_UID': str(os.getuid()), 'LAB_GID': str(os.getgid()),
              'AZRAEL_PORT': str(port), 'AZRAEL_STORAGE_ROOT': str(storage),
              'AZRAEL_JUICE_SHOP_DATA_ROOT': str(storage / 'juice-shop-data'),
              'AZRAEL_JUICE_SHOP_LOG_ROOT': str(storage / 'juice-shop-logs'),
              'AZRAEL_JUICE_SHOP_FTP_ROOT': str(storage / 'juice-shop-ftp'),
              'AZRAEL_JUICE_SHOP_CSAF_ROOT': str(storage / 'juice-shop-csaf'),
              'AZRAEL_JUICE_SHOP_FRONTEND_ROOT': str(storage / 'juice-shop-frontend'),
              'AZRAEL_JUICE_SHOP_I18N_ROOT': str(storage / 'juice-shop-i18n'),
              'AZRAEL_WEB_LAB_SHELL': str(ensure_web_lab_shell()),
              'AZRAEL_WEB_LAB_IMAGE': web_image or os.environ.get('AZRAEL_WEB_LAB_IMAGE', 'docker.io/bkimminich/juice-shop:latest'),
              'AZRAEL_GPU_ENABLED': 'true' if profile == 'gpu' else 'false'}
    if profile == 'gpu':
        if not gpu_devices or not default_gpu:
            raise DeploymentError('GPU compose environment needs at least one verified UUID')
        ordered = [default_gpu] + [item for item in gpu_devices if item['uuid'] != default_gpu['uuid']]
        values.update({'AZRAEL_GPU_UUID': default_gpu['uuid'],
                       'AZRAEL_GPU_DEVICE': 'all',
                       'AZRAEL_GPU_VISIBLE_DEVICES': ','.join(device['uuid'] for device in ordered),
                       'AZRAEL_GPU_MEMORY_FRACTION': os.environ.get('AZRAEL_GPU_MEMORY_FRACTION', '0.85'),
                       'AZRAEL_GPU_NAME': default_gpu['name'],
                       'AZRAEL_TORCH_INDEX_URL': 'https://download.pytorch.org/whl/cu128',
                       'AZRAEL_GPU_COMPOSE_FILE': str(GPU_COMPOSE_FILE)})
    else:
        values.update({'AZRAEL_TORCH_INDEX_URL': 'https://download.pytorch.org/whl/cpu'})
    RUNTIME.mkdir(mode=0o700, parents=True, exist_ok=True)
    lines = []
    for key, value in values.items():
        if '\n' in value or '\r' in value:
            raise DeploymentError(f'Invalid newline in {key}')
        lines.append(f'{key}={value}')
    temporary = ENV_FILE.with_suffix('.tmp')
    temporary.write_text('\n'.join(lines) + '\n')
    temporary.chmod(0o600)
    os.replace(temporary, ENV_FILE)
    ENV_FILE.chmod(0o600)
    os.environ.update(values)
    if profile == 'cpu':
        for key in ('AZRAEL_GPU_COMPOSE_FILE', 'AZRAEL_GPU_UUID', 'AZRAEL_GPU_DEVICE',
                    'AZRAEL_GPU_VISIBLE_DEVICES', 'CUDA_VISIBLE_DEVICES', 'AZRAEL_GPU_NAME'):
            os.environ.pop(key, None)
    return values


def generate_gpu_compose(devices, default_gpu):
    if not devices:
        raise DeploymentError('Cannot generate GPU Compose override without verified GPUs')
    devices = [default_gpu] + [item for item in devices if item['uuid'] != default_gpu['uuid']]
    uuids = ','.join(device['uuid'] for device in devices)
    lines = [
        'services:', '  dashboard:', '    build:', '      args:',
        '        TORCH_INDEX_URL: https://download.pytorch.org/whl/cu128',
        '    devices:',
    ]
    # Podman 4.9/NVIDIA CDI runs a hook for every selector. Passing one
    # aggregate selector avoids duplicate-hook collisions; CUDA visibility and
    # workload assignment remain pinned to the discovered UUIDs below.
    lines.append('      - nvidia.com/gpu=all')
    lines += ['    environment:', '      AZRAEL_GPU_ENABLED: "true"',
              f'      AZRAEL_GPU_NAME: "{default_gpu["name"]}"',
              f'      AZRAEL_GPU_UUID: "{default_gpu["uuid"]}"',
              f'      AZRAEL_GPU_VISIBLE_DEVICES: "{uuids}"',
              f'      CUDA_VISIBLE_DEVICES: "{uuids}"',
              f'      AZRAEL_GPU_MEMORY_FRACTION: "{os.environ.get("AZRAEL_GPU_MEMORY_FRACTION", "0.85")}"',
              '      LD_LIBRARY_PATH: "/usr/lib/x86_64-linux-gnu"',
              '      AZRAEL_GPU_REQUIRED: "false"']
    GPU_COMPOSE_FILE.write_text('\n'.join(lines) + '\n')
    GPU_COMPOSE_FILE.chmod(0o600)


def compose_prefix(gpu=False):
    provider = provider_env()['PODMAN_COMPOSE_PROVIDER']
    command = [shutil.which('podman') or 'podman', 'compose', '--file', str(ROOT / 'compose.yaml'),
               '--file', str(ROOT / 'compose.podman.yaml')]
    if gpu:
        gpu_file = os.environ.get('AZRAEL_GPU_COMPOSE_FILE')
        command += ['--file', gpu_file or str(ROOT / 'compose.gpu.yaml')]
    command += ['--project-name', PROJECT]
    return command


def compose_environment(port=8765, gpu=False):
    import setup_lab
    os.environ.update(read_compose_env())
    env = setup_lab._env(port, gpu)
    env.update(read_compose_env())
    env['PODMAN_COMPOSE_PROVIDER'] = provider_executable()
    return env


def read_compose_env():
    values = {}
    if not ENV_FILE.is_file():
        return values
    if ENV_FILE.is_symlink() or ENV_FILE.stat().st_uid != os.getuid() or ENV_FILE.stat().st_mode & 0o077:
        raise DeploymentError('Runtime Compose environment file must be owner-only and owned by the project user')
    for line in ENV_FILE.read_text().splitlines():
        if not line or line.startswith('#') or '=' not in line:
            continue
        key, value = line.split('=', 1)
        if re.fullmatch(r'[A-Z][A-Z0-9_]*', key):
            values[key] = value
    return values


def run_compose_up(service, *, gpu=False, force=False, env=None):
    command = compose_prefix(gpu) + ['up', '-d', '--no-deps',
                                     '--force-recreate' if force else '--no-recreate', service]
    return run(command, env=env, timeout=300)


def service_manager_start():
    """Recover only missing, stopped, or unhealthy AZRAEL containers after boot."""
    import setup_lab
    state = json.loads(STATE.read_text()) if STATE.is_file() else {}
    gpu = state.get('profile') == 'gpu'
    if gpu:
        ensure_cdi_compat_spec()
    env = compose_environment(gpu=gpu)
    if gpu:
        env['AZRAEL_GPU_COMPOSE_FILE'] = str(GPU_COMPOSE_FILE)
    for service in START_ORDER:
        current = current_containers(env).get(service)
        if current is None:
            run_compose_up(service, gpu=gpu, force=False, env=env)
        elif current.get('State', {}).get('Status') != 'running':
            run(['podman', 'start', current['Id']], env=env, timeout=300)
        elif (current.get('State', {}).get('Health') or {}).get('Status') == 'unhealthy':
            run(['podman', 'restart', '--time', '10', current['Id']], env=env, timeout=300)
        setup_lab.wait_for_services_healthy('podman', [service], timeout=300 if service == 'dashboard' else 180)


def service_manager_stop():
    """Gracefully stop the AZRAEL Compose services while preserving their data."""
    state = json.loads(STATE.read_text()) if STATE.is_file() else {}
    gpu = state.get('profile') == 'gpu'
    env = compose_environment(gpu=gpu)
    if gpu:
        env['AZRAEL_GPU_COMPOSE_FILE'] = str(GPU_COMPOSE_FILE)
    run(compose_prefix(gpu) + ['stop'], env=env, timeout=300)
    note('AZRAEL-54 services stopped through the rootless lifecycle manager; persistent state retained')


def boot_service_manager(profile, port):
    SYSTEMD_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    if UNIT_FILE.exists() and 'AZRAEL-54 managed rootless stack' not in UNIT_FILE.read_text(errors='replace'):
        raise DeploymentError(f'Refusing to overwrite unrelated user service {UNIT_FILE}')
    gpu = profile == 'gpu'
    files = compose_prefix(gpu)
    env_path = ENV_FILE
    content = f'''# AZRAEL-54 managed rootless stack
[Unit]
Description=AZRAEL-54 managed rootless stack
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={ROOT}
EnvironmentFile={env_path}
Environment=PODMAN_COMPOSE_PROVIDER={provider_executable()}
ExecStart={shlex.quote(str(ROOT / 'azraelctl'))} _service-start
ExecStop={shlex.quote(str(ROOT / 'azraelctl'))} _service-stop
TimeoutStartSec=0
TimeoutStopSec=360
KillMode=process

[Install]
WantedBy=default.target
'''
    temporary = UNIT_FILE.with_suffix('.tmp')
    temporary.write_text(content)
    temporary.chmod(0o600)
    os.replace(temporary, UNIT_FILE)
    run(['systemctl', '--user', 'daemon-reload'], timeout=60)
    run(['systemctl', '--user', 'enable', '--now', 'azrael54.service'], timeout=300)
    lingering = None
    if shutil.which('loginctl'):
        shown = run(['loginctl', 'show-user', str(os.getuid()), '-p', 'Linger', '--value'],
                    check=False, display=False, timeout=20)
        lingering = shown.stdout.strip().lower() == 'yes'
        if not lingering:
            enabled = run(['loginctl', 'enable-linger', str(os.getuid())], check=False,
                          display=False, timeout=20)
            if enabled.returncode == 0:
                check = run(['loginctl', 'show-user', str(os.getuid()), '-p', 'Linger', '--value'],
                            check=False, display=False, timeout=20)
                lingering = check.stdout.strip().lower() == 'yes'
    unit = run(['systemctl', '--user', 'is-active', 'azrael54.service'],
               check=False, display=False, timeout=20)
    if unit.stdout.strip() != 'active':
        raise DeploymentError('Rootless systemd lifecycle unit did not become active')
    return {'unit': str(UNIT_FILE), 'unit_active': True, 'unit_enabled': True,
            'linger_enabled': lingering, 'reboot_persistence': 'verified' if lingering else 'pending_linger_privilege'}


