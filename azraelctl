def audit_recreation(service, item, env):
    if not item:
        return {'service': service, 'status': 'new-container'}
    started = item.get('State', {}).get('StartedAt')
    diff = run(['podman', 'diff', item['Id']], env=env, display=False)
    if diff.returncode:
        raise DeploymentError(f'Could not inspect writable layer for {service}; refusing recreation')
    import writable_layer_audit
    audit = writable_layer_audit.audit_diff(started, diff.stdout)
    verified_mounts = []
    verified_bind_mounts = []
    if audit['status'] == 'blocked':
        entries = set(audit['unexpected_entries'])
        if entries and entries <= {'A /healthcheck.py'}:
            verified_mounts = backup_readonly_healthcheck_bind(service, item)
            audit['unexpected_entries'] = []
            audit['ignored_entries'].extend(['verified read-only bind A /healthcheck.py'])
            audit['status'] = 'clean'
    if audit['status'] == 'blocked':
        mount_entries = list(audit['unexpected_entries'])
        verified_bind_mounts = verify_bind_mountpoint_diff(service, item, mount_entries)
        if verified_bind_mounts:
            audit['unexpected_entries'] = []
            audit['ignored_entries'].extend('verified bind mountpoint ' + entry for entry in mount_entries)
            audit['status'] = 'clean'
    if audit['status'] == 'blocked' and service != 'web-lab':
        raise DeploymentError(f'{service} has unbacked writable-layer changes; refusing recreation: ' +
                              ', '.join(audit['unexpected_entries'][:20]))
    if audit['status'] == 'blocked' and service == 'web-lab':
        return {'service': service, 'status': 'changes-will-be-snapshotted-and-migrated',
                'changed_paths': audit['unexpected_entries']}
    return {'service': service, 'status': audit['status'],
            'ignored_entries': audit.get('ignored_entries', []),
            'verified_readonly_mount_backups': verified_mounts,
            'verified_bind_mountpoint_sources': verified_bind_mounts}


def verify_bind_mountpoint_diff(service, item, entries):
    """Recognize only Podman diff entries that are mount targets or their parent directories."""
    mounts = item.get('Mounts') or []
    candidates = []
    for mount in mounts:
        if mount.get('Type') != 'bind' or not mount.get('Source') or not mount.get('Destination'):
            continue
        raw_source = Path(mount['Source'])
        if raw_source.is_symlink() or not raw_source.exists():
            continue
        source = raw_source.resolve(strict=True)
        destination = os.path.normpath(mount['Destination'])
        project_root = ROOT.resolve()
        storage_root = Path(os.environ.get('AZRAEL_STORAGE_ROOT', '/data/work/azrael54')).resolve()
        if not (source == project_root or project_root in source.parents or
                source == storage_root or storage_root in source.parents):
            continue
        candidates.append({'source': str(source), 'destination': destination,
                           'read_only': mount.get('RW') is False,
                           'source_kind': 'directory' if source.is_dir() else 'file'})
    parsed = []
    verified_destinations = set()
    for entry in entries:
        parts = entry.split(' ', 1)
        if len(parts) != 2 or parts[0] not in {'A', 'C'}:
            return []
        status, raw_path = parts
        path = os.path.normpath(raw_path)
        exact = [mount for mount in candidates if mount['destination'] == path]
        descendants = [mount for mount in candidates
                       if mount['destination'].startswith(path.rstrip('/') + '/')]
        if exact:
            verified_destinations.update(mount['destination'] for mount in exact)
            parsed.append({'entry': entry, 'kind': 'bind-mount-target'})
        elif descendants and status == 'C':
            parsed.append({'entry': entry, 'kind': 'mount-parent-directory'})
        else:
            return []
    if not parsed or not verified_destinations:
        return []
    referenced = [mount for mount in candidates if mount['destination'] in verified_destinations]
    backup_dir = make_backup_directory()
    save_json(backup_dir / 'mountpoint-audit.json', {
        'service': service, 'container_id': item.get('Id'),
        'status': 'verified_mountpoints_only', 'diff_entries': parsed,
        'bind_mounts': referenced,
        'source_persistence': 'verified host bind sources remain outside the container layer'})
    return [{'backup': str(backup_dir / 'mountpoint-audit.json'), **mount}
            for mount in referenced]


def backup_readonly_healthcheck_bind(service, item):
    """Back up only the exact project healthcheck source proven read-only by inspect."""
    project = ROOT.resolve()
    matches = [mount for mount in item.get('Mounts', [])
               if mount.get('Destination') == '/healthcheck.py']
    if len(matches) != 1:
        raise DeploymentError(f'{service} reports A /healthcheck.py but does not have one exact bind mount')
    mount = matches[0]
    source = Path(mount.get('Source', '')).resolve(strict=True)
    if (mount.get('Type') != 'bind' or mount.get('RW') is not False or
            source != project / 'healthcheck.py' or not source.is_file()):
        raise DeploymentError(f'{service} /healthcheck.py is not the expected read-only project bind mount')
    backup_dir = make_backup_directory()
    destination = backup_dir / 'important-files' / service / 'healthcheck.py'
    destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    shutil.copyfile(source, destination)
    destination.chmod(0o600)
    source_hash = hashlib.sha256(source.read_bytes()).hexdigest()
    backup_hash = hashlib.sha256(destination.read_bytes()).hexdigest()
    if source_hash != backup_hash:
        raise DeploymentError(f'{service} read-only healthcheck backup failed verification')
    save_json(backup_dir / 'readonly-bind-manifest.json', {
        'service': service, 'container_destination': '/healthcheck.py',
        'source': str(source), 'source_sha256': source_hash,
        'backup': str(destination), 'backup_sha256': backup_hash,
        'mount_type': mount['Type'], 'read_only': True, 'verification': 'passed'})
    return [{'source': str(source), 'backup': str(destination), 'sha256': source_hash,
             'verification': 'passed'}]


def make_backup_directory():
    timestamp = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')
    path = BACKUP_ROOT / f'azraelctl-{timestamp}-{time.time_ns()}'
    path.mkdir(mode=0o700, parents=True, exist_ok=False)
    path.chmod(0o700)
    return path


def verify_api_inference(port, device, require_cuda=False):
    import setup_lab
    base = f'http://127.0.0.1:{port}'
    host = f'127.0.0.1:{port}'
    headers = {'Host': host, 'Origin': 'http://' + host,
               'X-Lab-Request': '1', 'Content-Type': 'application/json'}
    _, login_headers, _ = setup_lab._http(base + '/api/login', 'POST',
        json.dumps({'token': (ROOT / '.runtime/admin-token').read_text().strip()}).encode(), headers, timeout=10)
    cookie = login_headers.get('Set-Cookie', '').split(';', 1)[0]
    if not cookie.startswith('lab_session='):
        raise DeploymentError('Authenticated inference verification could not establish an admin session')
    headers['Cookie'] = cookie
    status, _, body = setup_lab._http(base + '/api/ops/inference', 'POST', json.dumps({
        'prompt': 'Reply with the single word READY.', 'device': device,
        'model': 'Qwen/Qwen2.5-Coder-1.5B-Instruct'}).encode(), headers, timeout=300)
    if status != 200:
        raise DeploymentError(f'Inference API returned HTTP {status}')
    result = json.loads(body)
    if not isinstance(result.get('text'), str) or not result['text'].strip():
        raise DeploymentError('Inference API returned an empty model response')
    if require_cuda and (not str(result.get('device', '')).startswith('cuda') or not result.get('gpu_memory_allocated_bytes')):
        raise DeploymentError('Inference API response did not prove CUDA model allocation')
    if device == 'cpu' and result.get('device') != 'cpu':
        raise DeploymentError('Explicit CPU fallback request did not execute on CPU')
    return {key: result.get(key) for key in ('model', 'device', 'device_name',
            'gpu_memory_allocated_bytes', 'generated_tokens', 'latency_ms', 'selected_device', 'gpu_fallback_reason')}


def restore_cpu_dashboard(port, web_ref, gpu_environment, failure):
    """Roll back only the dashboard/proxy pair to the verified CPU image and profile."""
    fallback = 'localhost/azrael54-dashboard:cpu-fallback'
    if not image_id(fallback, gpu_environment):
        raise DeploymentError('GPU deployment failed and the verified CPU rollback image is unavailable')
    run(['podman', 'tag', fallback, 'localhost/azrael54-dashboard:latest'], env=gpu_environment)
    values = write_compose_env('cpu', web_image=web_ref, port=port)
    environment = compose_environment(port, False)
    environment.update(values)
    environment['PODMAN_COMPOSE_PROVIDER'] = provider_executable()
    os.environ.update(environment)
    run(compose_prefix(False) + ['config'], env=environment)
    for service in ('dashboard', 'frontend'):
        run_compose_up(service, gpu=False, force=True, env=environment)
        import setup_lab
        setup_lab.wait_for_services_healthy('podman', [service], timeout=300)
    import setup_lab
    setup_lab.wait_for_services_healthy('podman', SERVICES, timeout=300)
    surface = verify_http_surface(port)
    dashboard = setup_lab.verify_dashboard(port)
    inference = setup_lab.verify_slm('podman', require_gpu=False, gpu=False)
    internal = setup_lab.verify_internal_services('podman')
    return {'status': 'cpu_fallback', 'reason': f'{type(failure).__name__}: {str(failure)[:900]}',
            'surface': surface, 'dashboard': dashboard, 'cpu_inference': inference,
            'internal_services': internal}


def persist_juice_manifest(backup_dir, migration):
    checksums = []
    for key in ('pre_stop_snapshot', 'final_snapshot'):
        snapshot = migration.get(key)
        if snapshot:
            checksums.append({'file': snapshot['archive'], 'sha256': snapshot['archive_sha256']})
    file_path = backup_dir / 'web-lab-latest/migration-manifest.json'
    value = json.loads(file_path.read_text())
    value['snapshot_archives'] = checksums
    db = Path(value['active_data']['path']) / 'juiceshop.sqlite'
    value['active_sqlite_sha256_after_migration'] = hashlib.sha256(db.read_bytes()).hexdigest()
    value['active_log_hashes'] = {str(path.relative_to(value['active_logs']['path'])):
        hashlib.sha256(path.read_bytes()).hexdigest()
        for path in Path(value['active_logs']['path']).rglob('*') if path.is_file()}
    save_json(file_path, value)
    for record in checksums:
        marker = Path(record['file'] + '.sha256')
        marker.write_text(f"{record['sha256']}  {Path(record['file']).name}\n")
        marker.chmod(0o600)
    return value


def run_cuda_probe(image, device_names, env):
    results = []
    for device in device_names:
        selector = 'nvidia.com/gpu=' + device['uuid']
        command = ['podman', 'run', '--rm', '--pull=never', '--network=none', '--userns=keep-id',
                   '--read-only', '--cap-drop=ALL', '--security-opt', 'no-new-privileges',
                   '--tmpfs', '/tmp:rw,noexec,nosuid,size=256m',
                   '--device', selector, '-e', 'CUDA_VISIBLE_DEVICES=' + device['uuid'],
                   '-e', 'AZRAEL_GPU_UUID=' + device['uuid'],
                   '-e', 'AZRAEL_GPU_EXPECTED_UUIDS=' + device['uuid'],
                   '-e', 'LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu',
                   '--entrypoint', '/app/.slm-venv/bin/python', image, '/app/gpu_probe.py']
        result = run(command, env=env, check=False, timeout=180)
        if result.returncode:
            results.append({'uuid': device['uuid'], 'name': device['name'], 'status': 'failed',
                            'error': result.stdout[-1800:]})
            continue
        try:
            report = json.loads(result.stdout.strip().splitlines()[-1])
            if report.get('status') != 'passed' or not report.get('devices'):
                raise ValueError('Probe did not report successful CUDA operations')
            results.append({'uuid': device['uuid'], 'name': device['name'], 'status': 'passed',
                            'runtime': report})
        except (ValueError, json.JSONDecodeError) as error:
            results.append({'uuid': device['uuid'], 'name': device['name'], 'status': 'failed',
                            'error': f'{type(error).__name__}: {result.stdout[-800:]}'})
    passed = [item for item in results if item['status'] == 'passed']
    if passed:
        uuids = ','.join(item['uuid'] for item in passed)
        command = ['podman', 'run', '--rm', '--pull=never', '--network=none', '--userns=keep-id',
                   '--read-only', '--cap-drop=ALL', '--security-opt', 'no-new-privileges',
                   '--tmpfs', '/tmp:rw,noexec,nosuid,size=256m',
                   '--device', 'nvidia.com/gpu=all', '-e', 'CUDA_VISIBLE_DEVICES=' + uuids,
                   '-e', 'AZRAEL_GPU_EXPECTED_UUIDS=' + uuids,
                   '-e', 'LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu',
                   '--entrypoint', '/app/.slm-venv/bin/python', image, '/app/gpu_probe.py']
        multi = run(command, env=env, check=False, timeout=240)
        if multi.returncode:
            multi_report = {'status': 'failed', 'error': multi.stdout[-1800:]}
        else:
            try:
                multi_report = json.loads(multi.stdout.strip().splitlines()[-1])
                if multi_report.get('status') != 'passed':
                    multi_report['status'] = 'failed'
            except (ValueError, json.JSONDecodeError):
                multi_report = {'status': 'failed', 'error': multi.stdout[-800:]}
    else:
        multi_report = {'status': 'skipped', 'reason': 'No individual GPU passed the CUDA operation probe'}
    return results, multi_report


def verify_http_surface(port):
    import setup_lab
    health, _, raw = setup_lab._http(f'http://127.0.0.1:{port}/healthz', timeout=5)
    page_status, _, page = setup_lab._http(f'http://127.0.0.1:{port}/', timeout=10)
    if health != 200 or page_status != 200 or b'id="opsCenter"' not in page or b'board-a-01-tactical-reaper-hero.png' not in page:
        raise DeploymentError('Frontend or proxied health endpoint failed verification')
    asset_status, _, asset = setup_lab._http(f'http://127.0.0.1:{port}/ops.js', timeout=10)
    if asset_status != 200 or b'/api/ops/status' not in asset:
        raise DeploymentError('Live operations client was not served by the frontend')
    return {'healthz': json.loads(raw), 'frontend': 'passed', 'azrael_artwork': 'passed', 'operations_client': 'passed'}


def build_dashboard_image(env, *, gpu=False):
    """Build the application image directly so provider errors cannot masquerade as success."""
    index = ('https://download.pytorch.org/whl/cu128' if gpu else
             'https://download.pytorch.org/whl/cpu')
    run(['podman', 'build', '--pull=never', '--tag', 'localhost/azrael54-dashboard:latest',
         '--file', 'container/Dockerfile.app', '--build-arg', 'TORCH_INDEX_URL=' + index, '.'],
        env=env, timeout=7200)
    if not image_id('localhost/azrael54-dashboard:latest', env):
        raise DeploymentError('Podman completed without producing the requested dashboard image')
    check = (
        "import hashlib,json,pathlib,stat; p=pathlib.Path('/app/ctf_assets'); "
        "c=json.loads((p/'catalog.json').read_text()); a=json.loads((p/'organizer-answer-key.json').read_text()); "
        "s=json.loads((p/'source/SOURCE.json').read_text()); l=(p/'source/LICENSE.md').read_bytes(); "
        "assert len(c['challenges'])==20 and set(a['answers'])=={x['id'] for x in c['challenges']}; "
        "assert c['source']==s and s['license']=='MIT'; "
        "assert hashlib.sha256(l).hexdigest()==s['license_file_sha256']; "
        "assert (p/'organizer-answer-key.json').stat().st_mode & 0o777 == 0o600; "
        "print(json.dumps({'ctf_assets':'passed','challenge_count':len(c['challenges']),"
        "'answer_ids_match':True,'license_hash':'passed','answer_key_mode':'0600'}))"
    )
    run(['podman', 'run', '--rm', '--pull=never', '--network=none', '--read-only',
         '--tmpfs', '/tmp:rw,noexec,nosuid,nodev,size=16m', '--entrypoint', '/app/.slm-venv/bin/python',
         'localhost/azrael54-dashboard:latest', '-c', check], env=env, timeout=60)
    return image_id('localhost/azrael54-dashboard:latest', env)


def bootstrap(gpu_mode='auto', port=8765, force_update=False):
    if os.getuid() == 0:
        raise DeploymentError('Run ./azraelctl as the ordinary rootless project user, not with sudo')
    host = supported_host()
    dependency = dependency_report()
    install_missing_dependencies(dependency)
    dependency = dependency_report()
    if dependency['missing_required']:
        raise DeploymentError('Required host dependencies are unavailable: ' + ', '.join(dependency['missing_required']))
    import setup_lab
    import storage_paths
    recovery = recovery_backup_status()
    note(f"Host detected: {host['distribution']} · {host['version']} · {host['architecture']}")
    note('Verified recovery backup: ' + str(BACKUP_ROOT))
    ensure_venv_dependencies()
    previous_state = json.loads(STATE.read_text()) if STATE.is_file() else {}
    if not force_update and gpu_mode != 'off' and previous_state.get('profile') == 'gpu':
        os.environ.update(read_compose_env())
        running = current_containers(provider_env())
        same_config = previous_state.get('compose_signature') == compose_signature()
        all_running = set(running) >= set(SERVICES) and all(health_is_healthy(running[name]) for name in SERVICES)
        restart_ready = all((running[name].get('HostConfig', {}).get('RestartPolicy') or {}).get('Name') == 'unless-stopped'
                            for name in SERVICES if name in running)
        if same_config and all_running and restart_ready:
            note('Existing GPU deployment is healthy and unchanged; skipping image rebuild and container recreation')
            verify_deployment()
            return 0
    storage = storage_paths.prepare_storage()
    if storage['write_readback'] != 'passed':
        raise DeploymentError('Persistent storage write/read verification failed')
    setup_lab.prepare_secrets()
    # Never replace the source Juice Shop image before it has a verified image snapshot.
    existing = current_containers(provider_env())
    old_manifest = recovery['manifest']
    old_ref = old_manifest.get('snapshot_image_ref')
    web_ref = old_ref if old_ref and image_id(old_ref, provider_env()) else 'docker.io/bkimminich/juice-shop:latest'
    os.environ['AZRAEL_WEB_LAB_IMAGE'] = web_ref
    os.environ['AZRAEL_STORAGE_ROOT'] = str(storage_paths.storage_root())
    env = write_compose_env('cpu', web_image=web_ref, port=port)
    env.update({'AZRAEL_WEB_LAB_IMAGE': web_ref,
                'AZRAEL_STORAGE_ROOT': str(storage_paths.storage_root()),
                'PODMAN_COMPOSE_PROVIDER': provider_executable()})
    os.environ.update(env)
    os.environ.pop('AZRAEL_GPU_COMPOSE_FILE', None)
    rootless = setup_lab.record_rootless_preflight()
    # First build and verify the CPU profile; currently running project containers are untouched here.
    cpu_commands = setup_lab.plan(install=False, build=True, start=False,
                                  runtime='podman', port=port, gpu=False)
    setup_lab.execute(cpu_commands, 'podman', port=port, verify=False, gpu=False,
                      rootless_preflight=rootless)
    note('Building the CPU dashboard image with strict Podman exit and CTF asset integrity checks')
    build_dashboard_image(compose_environment(port, False), gpu=False)

    signature = compose_signature()
    service_signatures = compose_service_signatures(gpu=False)
    current = current_containers(env)
    expected_refs = dict(setup_lab.LOCAL_IMAGES)
    expected_refs['web-lab'] = web_ref
    expected_ids = {name: image_id(reference, env) for name, reference in expected_refs.items()}
    old_state = json.loads(STATE.read_text()) if STATE.is_file() else {}
    recreate = {service for service in SERVICES
                if needs_recreation(service, current.get(service), expected_ids.get(service), signature,
                                    old_state, gpu=False, service_signature=service_signatures[service])}
    for service in recreate:
        audit_recreation(service, current.get(service), env)
    if 'web-lab' in recreate and current.get('web-lab'):
        backup_dir = make_backup_directory()
        note('Backing up and migrating the Juice Shop writable layer before its required recreation')
        try:
            migration = snapshot_and_migrate_web_lab(current['web-lab'], backup_dir, env)
            migration = persist_juice_manifest(backup_dir, migration)
            web_ref = 'localhost/azrael54-web-lab-preserved:latest'
            env = write_compose_env('cpu', web_image=web_ref, port=port)
            env.update({'AZRAEL_WEB_LAB_IMAGE': web_ref,
                        'AZRAEL_STORAGE_ROOT': str(storage_paths.storage_root()),
                        'PODMAN_COMPOSE_PROVIDER': provider_executable()})
            os.environ.update(env)
            # Revalidate the final Compose input with the verified snapshot image and persistent data bind mounts.
            run(setup_lab.compose_prefix('podman', False) + ['config'], env=env)
            expected_refs['web-lab'] = web_ref
            expected_ids['web-lab'] = image_id(web_ref, env)
            if not expected_ids['web-lab']:
                raise DeploymentError('Verified Juice Shop snapshot image is not available to Compose')
        except BaseException as error:
            restored = restore_web_lab_after_failure(current['web-lab'], env)
            note('Juice Shop pre-recreation recovery: ' + json.dumps(restored, sort_keys=True))
            if restored['status'] == 'recovery_required':
                raise DeploymentError(f'Juice Shop backup/migration completed but deployment preflight failed, '
                                      f'and the original service needs recovery: {restored["error"]}') from error
            raise
    else:
        backup_dir = None
        migration = None

    note('Starting or recreating only the AZRAEL services whose health, image, profile, or Compose configuration requires it')
    for service in START_ORDER:
        item = current.get(service)
        if service in recreate:
            force = bool(item)
        elif item and item.get('State', {}).get('Status') == 'running':
            continue
        else:
            force = False
        try:
            run_compose_up(service, gpu=False, force=force, env=env)
            setup_lab.wait_for_services_healthy('podman', [service], timeout=300 if service == 'dashboard' else 180)
        except BaseException as error:
            if service == 'web-lab' and item and item.get('State', {}).get('Status') == 'running':
                recovery_status = restore_web_lab_after_failure(item, env)
                note('Juice Shop failure recovery: ' + json.dumps(recovery_status, sort_keys=True))
                if recovery_status['status'] == 'recovery_required':
                    raise DeploymentError(f'Juice Shop deployment failed and automatic recovery needs attention; '
                                          f'verified snapshot preserved at {recovery_status["snapshot_image"]}: '
                                          f'{recovery_status["error"]}') from error
            raise
    setup_lab.wait_for_services_healthy('podman', SERVICES, timeout=300)
    surface = verify_http_surface(port)
    dashboard = setup_lab.verify_dashboard(port)
    internal = setup_lab.verify_internal_services('podman')
    cpu_inference = setup_lab.verify_slm('podman', require_gpu=False, gpu=False)
    persist_state({'profile': 'cpu', 'compose_signature': signature,
                   'service_signatures': service_signatures,
                   'service_images': expected_ids, 'backup_directory': str(backup_dir) if backup_dir else None,
                   'juice_shop_migration': migration, 'rootless_preflight': rootless,
                   'cpu_verification': {'surface': surface, 'dashboard': dashboard,
                                        'internal_services': internal, 'slm_inference': cpu_inference}})
    note('CPU deployment verified: frontend, authenticated API, all service healthchecks and CPU model inference passed')

    gpu_host = setup_lab.gpu_status()
    gpu_result = {'requested': gpu_mode, 'host': gpu_host, 'status': 'skipped', 'reason': None}
    if gpu_mode != 'off':
        try:
            if not gpu_host.get('host_gpu_detected'):
                raise DeploymentError('Host nvidia-smi did not detect a GPU')
            if not gpu_host.get('nvidia_container_toolkit') or gpu_host.get('nvidia_cdi', {}).get('status') != 'passed':
                raise DeploymentError('NVIDIA Container Toolkit/CDI is not available to rootless Podman')
            host_devices = setup_lab.host_gpu_inventory()
            setup_lab.gpu_disk_space_preflight('podman')
            if not host_devices:
                raise DeploymentError('NVIDIA host inventory is empty')
            cdi_probes = []
            for device in host_devices:
                try:
                    result = setup_lab.gpu_container_preflight('podman', device_selector=device['uuid'])
                    cdi_probes.append({'uuid': device['uuid'], 'name': device['name'],
                                       'status': 'passed', 'verification': result})
                except Exception as error:
                    cdi_probes.append({'uuid': device['uuid'], 'name': device['name'],
                                       'status': 'failed',
                                       'error': f'{type(error).__name__}: {str(error)[:1200]}'})
            passed_devices = [device for device, probe in zip(host_devices, cdi_probes)
                              if probe['status'] == 'passed']
            gpu_result['per_gpu_rootless_cdi_preflight'] = cdi_probes
            gpu_result['host_devices'] = passed_devices
            if passed_devices:
                gpu_result['status'] = 'host_and_cdi_ready'
            else:
                failures = '; '.join(f"{item['name']}: {item.get('error', 'probe failed')}"
                                     for item in cdi_probes)
                gpu_result.update(status='cpu_fallback', reason=failures or 'No GPU passed rootless CDI preflight')
        except Exception as error:
            gpu_result.update(status='cpu_fallback', reason=f'{type(error).__name__}: {str(error)[:1200]}')

    if gpu_result['status'] == 'host_and_cdi_ready':
        # Preserve the working CPU dashboard image for rollback before building a CUDA image.
        cpu_id = image_id('localhost/azrael54-dashboard:latest', env)
        if not cpu_id:
            raise DeploymentError('CPU dashboard image disappeared before CUDA build')
        run(['podman', 'tag', 'localhost/azrael54-dashboard:latest',
             'localhost/azrael54-dashboard:cpu-fallback'], env=env)
        host_devices = gpu_result['host_devices']
        preferred = next((item for item in host_devices if 'rtx 3080' in item['name'].casefold()), host_devices[0])
        generate_gpu_compose(host_devices, preferred)
        gpu_env_values = write_compose_env('gpu', host_devices, preferred, web_ref, port)
        gpu_env = compose_environment(port, True)
        gpu_env.update(gpu_env_values)
        gpu_env['AZRAEL_GPU_COMPOSE_FILE'] = str(GPU_COMPOSE_FILE)
        os.environ.update(gpu_env)
        run(compose_prefix(True) + ['config'], env=gpu_env)
        build_dashboard_image(gpu_env, gpu=True)
        cuda_image = 'localhost/azrael54-dashboard:latest'
        per_gpu, multi_gpu = run_cuda_probe(cuda_image, host_devices, gpu_env)
        passed = [host_devices[index] for index, result in enumerate(per_gpu) if result['status'] == 'passed']
        gpu_result.update(per_gpu=per_gpu, multi_gpu=multi_gpu)
        if not passed:
            gpu_result.update(status='cpu_fallback', reason='No GPU completed real container CUDA matrix and optimizer-step probes')
            run(['podman', 'tag', 'localhost/azrael54-dashboard:cpu-fallback',
                 'localhost/azrael54-dashboard:latest'], env=gpu_env)
        else:
            try:
                preferred_passed = next((item for item in passed if item['uuid'] == preferred['uuid']), passed[0])
                generate_gpu_compose(passed, preferred_passed)
                gpu_env_values = write_compose_env('gpu', passed, preferred_passed, web_ref, port)
                gpu_env = compose_environment(port, True)
                gpu_env.update(gpu_env_values)
                gpu_env['AZRAEL_GPU_COMPOSE_FILE'] = str(GPU_COMPOSE_FILE)
                os.environ.update(gpu_env)
                run(compose_prefix(True) + ['config'], env=gpu_env)
                # GPU profile changes only the dashboard runtime; recreate that worker and frontend DNS proxy.
                for service in ('dashboard', 'frontend'):
                    run_compose_up(service, gpu=True, force=True, env=gpu_env)
                    setup_lab.wait_for_services_healthy('podman', [service], timeout=300)
                setup_lab.wait_for_services_healthy('podman', SERVICES, timeout=300)
                gpu_health = setup_lab.verify_gpu_container('podman')
                gpu_inference = setup_lab.verify_slm('podman', require_gpu=True, gpu=True)
                device_inference = verify_api_inference(port, preferred_passed['uuid'], require_cuda=True)
                cpu_api_fallback = verify_api_inference(port, 'cpu', require_cuda=False)
                ctf_practice = setup_lab.verify_ctf_model_practice(port)
                if not str(ctf_practice.get('device', '')).startswith('cuda') or not ctf_practice.get('gpu_memory_allocated_bytes'):
                    raise DeploymentError('CTF model practice did not prove CUDA inference allocation')
                surface = verify_http_surface(port)
                dashboard = setup_lab.verify_dashboard(port)
                internal = setup_lab.verify_internal_services('podman')
                if multi_gpu.get('status') != 'passed':
                    gpu_result['multi_gpu']['deployment_note'] = 'GPU workers are assigned by stable UUID per workload; model sharding is not enabled.'
                gpu_result.update(status='passed' if len(passed) == len(host_devices) and multi_gpu.get('status') == 'passed' else 'partial',
                                  cuda_container=gpu_health, slm_inference=gpu_inference,
                                  ctf_model_practice=ctf_practice,
                                  authenticated_gpu_api_inference=device_inference,
                                  authenticated_cpu_fallback=cpu_api_fallback)
                service_signatures = compose_service_signatures(gpu=True)
                gpu_images = dict(expected_ids)
                gpu_images['dashboard'] = image_id('localhost/azrael54-dashboard:latest', gpu_env)
                persist_state({'profile': 'gpu', 'compose_signature': compose_signature(),
                               'service_signatures': service_signatures,
                               'service_images': gpu_images, 'gpu': gpu_result,
                               'backup_directory': str(backup_dir) if backup_dir else None,
                               'juice_shop_migration': migration,
                               'verification': {'surface': surface, 'dashboard': dashboard,
                                                'internal_services': internal},
                               'rootless_preflight': rootless})
            except Exception as error:
                note(f'GPU service verification failed; restoring the preserved CPU profile: {type(error).__name__}: {str(error)[:500]}')
                rollback = restore_cpu_dashboard(port, web_ref, gpu_env, error)
                gpu_result.update(status='cpu_fallback', reason=rollback['reason'], cpu_rollback='passed')
                fallback_state = json.loads(STATE.read_text()) if STATE.is_file() else {}
                fallback_state.update({'profile': 'cpu', 'compose_signature': compose_signature(),
                    'service_signatures': compose_service_signatures(gpu=False),
                    'service_images': expected_ids, 'gpu': gpu_result,
                    'backup_directory': str(backup_dir) if backup_dir else None,
                    'juice_shop_migration': migration,
                    'cpu_verification': {'surface': rollback['surface'], 'dashboard': rollback['dashboard'],
                                         'internal_services': rollback['internal_services'],
                                         'slm_inference': rollback['cpu_inference']}})
                persist_state(fallback_state)
    if gpu_result['status'] in {'cpu_fallback', 'skipped', 'host_and_cdi_ready'}:
        # A CUDA build may be present as an image tag, but do not replace the running CPU service on failure.
        state = json.loads(STATE.read_text()) if STATE.is_file() else {}
        state.update({'profile': 'cpu', 'compose_signature': signature,
                      'service_signatures': compose_service_signatures(gpu=False),
                      'service_images': expected_ids, 'gpu': gpu_result,
                      'backup_directory': str(backup_dir) if backup_dir else None,
                      'juice_shop_migration': migration})
        persist_state(state)

    if gpu_result['status'] in {'cpu_fallback', 'skipped', 'host_and_cdi_ready'}:
        ctf_practice = verification_stage('offline CTF model practice on CPU',
            lambda: setup_lab.verify_ctf_model_practice(port))
        if ctf_practice.get('device') != 'cpu':
            raise DeploymentError('CPU fallback CTF practice did not report CPU execution')
        state = json.loads(STATE.read_text()) if STATE.is_file() else {}
        state.setdefault('cpu_verification', {})['ctf_model_practice'] = ctf_practice
        persist_state(state)

    services = current_containers(provider_env())
    all_healthy = all(service in services and health_is_healthy(services[service]) for service in SERVICES)
    if not all_healthy:
        raise DeploymentError('Final AZRAEL service health verification failed; see podman ps and azraelctl logs')
    restart_manager = boot_service_manager(json.loads(STATE.read_text()).get('profile', 'cpu'), port)
    state = json.loads(STATE.read_text())
    state['restart_manager'] = restart_manager
    state['final_status'] = {
        'passed': 'running_gpu', 'partial': 'running_gpu_partial',
        'skipped': 'running_cpu', 'cpu_fallback': 'running_cpu_with_gpu_issue',
        'host_and_cdi_ready': 'running_cpu_with_gpu_issue',
    }.get(gpu_result['status'], 'running_with_unverified_gpu_status')
    persist_state(state)
    note(f'Dashboard: http://127.0.0.1:{port}')
    note('Final profile: ' + state['profile'] + ' · all required containers healthy · services left running')
    note(json.dumps({'gpu_status': gpu_result['status'], 'restart_manager': restart_manager}, sort_keys=True))
    return 0 if gpu_result['status'] in {'passed', 'skipped'} else EXIT_DEPLOYMENT


