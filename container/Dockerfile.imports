FROM docker.io/library/python:3.12-slim
WORKDIR /opt/imports
COPY import_broker.py source_transport.py source_fetch_worker.py artifact_catalog.py public_sources.py ./
COPY role_research.py evidence_store.py role-search-profiles.json ./
USER 1000:1000
ENV HOME=/tmp PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
CMD ["python3", "import_broker.py"]
