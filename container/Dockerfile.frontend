FROM docker.io/library/nginx:1.27-alpine
COPY --chown=101:101 container/nginx.conf /etc/nginx/azrael-nginx.conf.template
COPY --chown=101:101 container/frontend-entrypoint.sh /usr/local/bin/azrael-frontend-entrypoint
COPY --chown=101:101 container/healthcheck-frontend.sh /usr/local/bin/healthcheck-frontend
COPY --chown=101:101 web/ /usr/share/nginx/html/
RUN chmod 0555 /usr/local/bin/healthcheck-frontend /usr/local/bin/azrael-frontend-entrypoint \
    && mkdir -p /tmp/client_temp /tmp/proxy_temp \
    && chown -R 101:101 /tmp/client_temp /tmp/proxy_temp /usr/share/nginx/html
USER 101:101
ENTRYPOINT ["/usr/local/bin/azrael-frontend-entrypoint"]
CMD ["-g", "daemon off;"]
